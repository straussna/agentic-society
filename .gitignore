# Ground truth and traces. Never commit; never mount.
records/

# Per-agent mirrors of what each episode wrote; copied in and out of the container.
environments/

# Preserved records and mirrors displaced when a command starts a fresh run.
displaced/

# Working notes and assessments written during a session. Not part of the harness.
Claude outputs/

# Console output of parallel processes. The trace is the record; these are scrollback.
*.log

__pycache__/
*.pyc
.venv/
